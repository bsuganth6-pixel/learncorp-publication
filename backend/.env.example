# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000
# Reverse proxies in front of the API (affects rate-limit client IPs). 1 = e.g. Render alone;
# the frontend's /api proxy adds a hop — see docs/DEPLOYMENT.md before changing.
TRUST_PROXY_HOPS=1

# Database
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/book-publication

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
COOKIE_NAME=bp_session

# Cloudinary (cover images, author photos, logo assets)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# S3-compatible storage for manuscript files (AWS S3 or Cloudflare R2)
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_BASE_URL=

# Initial admin seed (used once by npm run seed:admin)
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-this-immediately
