# Server
NODE_ENV=development
PORT=5000
# The site's browser origin(s): used for CORS, the CSRF origin check and the links in emails.
# Production must be https. Several origins may be listed, comma-separated (e.g. the *.vercel.app
# address and a custom domain); the FIRST one is used for links in emails.
CLIENT_URL=http://localhost:3000
# Reverse proxies in front of the API. Decides which X-Forwarded-For entry is treated as the
# client IP, which every rate limiter keys on. Local dev: 1. Render/Railway reached directly: 1.
# Render + the Vercel /api proxy (the recommended deployment): 2. Too low => all visitors share
# one rate-limit bucket; too high => clients can spoof their IP. See docs/DEPLOYMENT.md.
TRUST_PROXY_HOPS=1

# Database
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/book-publication

# Sessions. There is no signing secret: a session is a random token whose hash is stored in the
# database (so it can be revoked), not a JWT. Only the cookie's name is configurable.
COOKIE_NAME=bp_session

# Email: confirmation links, password resets and manuscript status updates.
#   console  prints messages to the server log (local development only; refused in production)
#   resend   https://resend.com HTTP API — works on hosts that block SMTP ports (Render free tier)
#   smtp     any SMTP server (Brevo, Gmail app password, Mailgun, ...)
EMAIL_PROVIDER=console
EMAIL_FROM="LearnCorp Publication <no-reply@your-domain.com>"
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Optional: requests per client IP per 15 minutes across the whole API (default 1000). Sign-in, sign-up and
# recovery have their own, much tighter limits that this does not change.
# API_RATE_LIMIT=1000

# Cloudinary (cover images, author photos, logo assets)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# S3-compatible storage for manuscript files (AWS S3 or Cloudflare R2)
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_BASE_URL=

# Initial administrator, used once by `npm run seed:admin` (keep these in your LOCAL .env only).
# The password must satisfy the same policy as every other account: 10+ characters, a letter and
# a number, not a common password. The script refuses anything weaker and never prints it.
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
# superadmin (default) can also manage other administrator accounts; admin cannot.
SEED_ADMIN_ROLE=superadmin

# Integration tests only (npm run test:integration): a MongoDB server the suites may create
# throw-away databases on. Defaults to mongodb://127.0.0.1:27017
# MONGODB_TEST_URI=mongodb://127.0.0.1:27017
