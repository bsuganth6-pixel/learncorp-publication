# Origin of the API: no trailing slash, no /api suffix. READ AT BUILD TIME —
# the browser only talks to this site; /api/* is proxied to this origin.
API_ORIGIN=http://localhost:5000

# Public URL of this site (canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Only if you changed COOKIE_NAME on the backend — it must match there
# COOKIE_NAME=bp_session
